From: Frank Meisenbach <fmeisenbach@hilscher.com>
Date: Wed, 8 Jun 2022 07:37:13 +0200
Subject: [PATCH] Add/Include netiot_distro_config.h support.

---
 include/configs/efi-x86_payload.h | 2 ++
 include/configs/x86-common.h      | 2 +-
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/include/configs/efi-x86_payload.h b/include/configs/efi-x86_payload.h
index 1cf5c037e8..3c26132082 100644
--- a/include/configs/efi-x86_payload.h
+++ b/include/configs/efi-x86_payload.h
@@ -29,4 +29,6 @@
 #define CONFIG_SYS_ATA_IDE1_OFFSET	0x170
 #define CONFIG_ATAPI
 
+#include "netiot_distro_config.h"
+
 #endif	/* __CONFIG_H */
diff --git a/include/configs/x86-common.h b/include/configs/x86-common.h
index 69fd1dad7f..17c2276d16 100644
--- a/include/configs/x86-common.h
+++ b/include/configs/x86-common.h
@@ -111,7 +111,7 @@
 #endif
 
 #define CONFIG_EXTRA_ENV_SETTINGS			\
-	DISTRO_BOOTENV					\
+	NETIOT_CONFIG_EXTRA_ENV_SETTINGS	\
 	CONFIG_STD_DEVICES_SETTINGS			\
 	"pciconfighost=1\0"				\
 	"netdev=eth0\0"					\
