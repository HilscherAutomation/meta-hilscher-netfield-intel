 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/drivers/media/cec/core/cec-adap.c b/drivers/media/cec/core/cec-adap.c
index 01ff1329e01c..1b72063f242e 100644
--- a/drivers/media/cec/core/cec-adap.c
