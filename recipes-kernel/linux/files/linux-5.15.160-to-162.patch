diff --git a/fs/proc/vmcore.c b/fs/proc/vmcore.c
index e5730986758f..36b7316ef48d 100644
--- a/fs/proc/vmcore.c
+++ b/fs/proc/vmcore.c
@@ -373,6 +373,8 @@ static ssize_t __read_vmcore(char *buffer, size_t buflen, loff_t *fpos,
